APP_NAME="Enterprise RAG Assistant"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Supabase PostgreSQL + pgvector -------------------------------------
# Supabase dashboard > Connect > "Session pooler" URI (port 5432).
# Do not use the transaction pooler (port 6543): it breaks prepared statements.
# Example: postgresql://postgres.abcdefgh:YOUR-PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
DB_CONNECTION=pgsql
DB_URL=

# --- Redis (Memurai on Windows) -----------------------------------------
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=array
BROADCAST_CONNECTION=log

# --- File storage -------------------------------------------------------
# "local" stores uploads under storage/app/private/documents/{organization_id}/
FILESYSTEM_DISK=local

# --- AI service (FastAPI) -----------------------------------------------
AI_SERVICE_URL=http://127.0.0.1:8001
# Shared secret sent as the X-Internal-Secret header. Must be identical to
# INTERNAL_API_SECRET in ai-service/.env. Generate with:
#   php -r "echo bin2hex(random_bytes(32));"
INTERNAL_API_SECRET=

MAIL_MAILER=log
